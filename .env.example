# ─────────────────────────────────────────────────────────────────────────────
# Project Athena — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API key for Claude AI narrative generation
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# API key that protects all mutating endpoints (/attack, /start-demo, /reset-demo, /debug-log)
# Generate a strong random value: openssl rand -hex 32
DEMO_API_KEY=changeme-generate-a-strong-secret

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Port the Express server listens on
PORT=3001

# Comma-separated list of allowed CORS origins (no trailing slash)
# Add your production frontend URL here when deploying
ALLOWED_ORIGINS=http://localhost:5173

# Claude API usage limits (cost cap per hour in USD)
MAX_CLAUDE_CALLS_PER_HOUR=100
MAX_COST_PER_HOUR=1.00

# ── Okta Webhook HMAC (leave empty to skip signature validation in dev) ───────
# Set this to the secret configured in your Okta Event Hook for HMAC verification
# Required for production deployments
OKTA_WEBHOOK_SECRET=
