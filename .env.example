# ─────────────────────────────────────────────────────────────────────────────
# Project Athena — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API key for Claude AI narrative generation
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# API key that protects all mutating endpoints (/attack, /start-demo, /reset-demo, /debug-log, /ssf/transmit)
# Generate a strong random value: openssl rand -hex 32
DEMO_API_KEY=changeme-generate-a-strong-secret

# Vite-exposed copy of DEMO_API_KEY — must match the value above exactly.
# The frontend reads this to authenticate SSF transmit and attack requests.
VITE_DEMO_API_KEY=changeme-generate-a-strong-secret

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Port the Express server listens on
PORT=3001

# Comma-separated list of allowed CORS origins (no trailing slash)
# Add your production frontend URL here when deploying
ALLOWED_ORIGINS=http://localhost:5173

# Claude API usage limits (cost cap per hour in USD)
MAX_CLAUDE_CALLS_PER_HOUR=100
MAX_COST_PER_HOUR=1.00

# ── Database ──────────────────────────────────────────────────────────────────
# In development: SQLite is used automatically (no config needed)
# In production (NODE_ENV=production): set DATABASE_URL to a PostgreSQL DSN
DATABASE_URL=postgres://user:password@localhost:5432/athena

# SQLite file path for development (default: server/db/athena-dev.sqlite3)
# SQLITE_PATH=./db/athena-dev.sqlite3

# ── Okta Webhook HMAC (leave empty to skip signature validation in dev) ───────
# Set this to the secret configured in your Okta Event Hook for HMAC verification
# Required for production deployments
OKTA_WEBHOOK_SECRET=
